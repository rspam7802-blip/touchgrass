{
  "name": "@touchgrass/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node scripts/dev.mjs",
    "start:api": "node dist/main.js",
    "start:realtime": "node dist/realtime.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --project integration",
    "db:migrate": "node dist/infra/database/migrate.cli.js up",
    "db:rollback": "node dist/infra/database/migrate.cli.js down",
    "db:seed": "node dist/seed/seed.cli.js",
    "db:bootstrap": "node dist/seed/bootstrap.cli.js",
    "storage:init": "node dist/adapters/storage/storage-init.cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "3.1161.0",
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/client-sesv2": "3.1161.0",
    "@aws-sdk/s3-presigned-post": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/platform-socket.io": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@nestjs/websockets": "12.3.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@sentry/nestjs": "11.10.0",
    "@socket.io/redis-adapter": "8.3.0",
    "@socket.io/redis-emitter": "5.1.0",
    "@touchgrass/shared": "workspace:*",
    "bullmq": "6.5.3",
    "drizzle-orm": "0.45.4",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "uuidv7": "1.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2",
    "@swc/core": "1.16.21",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@touchgrass/config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "pino-pretty": "13.2.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
