# Mobile build-time config (EXPO_PUBLIC_* values are embedded in the bundle — never put secrets here).
# Local API (use your machine's LAN IP when running on a physical device).
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_REALTIME_URL=http://localhost:4001
EXPO_PUBLIC_WEB_URL=http://localhost:3000
# Production share-link host for universal links / App Links (must serve /.well-known files).
# EXPO_PUBLIC_LINK_HOST=tg.app
# Sentry DSN for the mobile project (https://sentry.io → Project → Client Keys). Public by design.
# EXPO_PUBLIC_SENTRY_DSN=
# Google Maps SDK keys, restricted to the app's package name / bundle id (Google Cloud console → Credentials).
# EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
# EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
# EAS project id (expo.dev → project → ID). Needed to obtain Expo push tokens on device.
# EXPO_PUBLIC_EAS_PROJECT_ID=
