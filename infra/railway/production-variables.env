# GOING LIVE on Supabase + Railway with the lean setup (D-165, D-166). Railway → project → Settings →
# Shared Variables → Raw Editor: paste this, replace every <...>, attach to api, realtime and worker only.
# Never commit real values. Secrets: `openssl rand -hex 32` (three different ones).

NODE_ENV=production
APP_VERSION=0.1.0
LOG_LEVEL=info
MIN_SUPPORTED_APP_VERSION=0.1.0
LATEST_APP_VERSION=0.1.0
TRUST_PROXY_HOPS=1
API_WORKERS=1

# Supabase → Connect → Session pooler (port 5432), no ?sslmode; certificate as one line with \n.
DATABASE_URL=<postgres://postgres.<ref>:<password>@<pooler-host>:5432/postgres>
DATABASE_CA_CERT=<-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE----->
DATABASE_POOL_MAX=4
REDIS_URL=${{Redis.REDIS_URL}}?family=0

JWT_ACCESS_SECRET=<secret 1>
TOKEN_HASH_PEPPER=<secret 2>
SIGNED_URL_SECRET=<secret 3>

API_PUBLIC_URL=https://<api domain>
WEB_PUBLIC_URL=https://<web domain>
CORS_ORIGINS=https://<web domain>

# Sign-in: Firebase texts the codes; the server sends no SMS. App Store / Play reviewers use the fixed
# review number and code below (no SMS).
SMS_PROVIDER=none
PHONE_AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=<firebase project id>
STORE_REVIEW_PHONE=<+91 number you control, not a real person's>
STORE_REVIEW_OTP=<6 digits, not 000000>

# Free plans only until there is a company; no Razorpay.
PAYMENTS_PROVIDER=disabled

PUSH_PROVIDER=expo
EXPO_ACCESS_TOKEN=<expo.dev → Account settings → Access tokens>

MAPS_PROVIDER=google
GOOGLE_MAPS_API_KEY=<Google Cloud → APIs & Services → Credentials (Places + Geocoding only)>

WEATHER_PROVIDER=none

MODERATION_PROVIDER=google-vision
GOOGLE_VISION_API_KEY=<Google Cloud → Credentials (Cloud Vision API only)>

ANALYTICS_PROVIDER=noop
# Receipts are the only emails and there are no payments; any real SMTP service works (e.g. Brevo free).
EMAIL_PROVIDER=smtp
SMTP_URL=<smtp://user:password@smtp-relay.brevo.com:587>
EMAIL_FROM=TouchGrass <hello@<your domain>>

STORAGE_PROVIDER=s3
S3_ENDPOINT=https://<storage domain>
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=<RUSTFS_ACCESS_KEY of the storage service>
S3_SECRET_ACCESS_KEY=<RUSTFS_SECRET_KEY of the storage service>
S3_FORCE_PATH_STYLE=true
S3_BUCKET_MEDIA=touchgrass-media
MEDIA_PUBLIC_BASE_URL=https://<storage domain>/touchgrass-media

# ---- Not shared: set these on the `web` service only (Variables tab) ----
# PORT=3000
# API_URL=https://<api domain>
# MEDIA_PUBLIC_BASE_URL=https://<storage domain>/touchgrass-media
# SUPPORT_EMAIL=<support address>
# LEGAL_ENTITY_NAME=<your full name until there is a company>
# LEGAL_ADDRESS=<postal address for /contact>
# GRIEVANCE_OFFICER_NAME=<name>
# GRIEVANCE_OFFICER_EMAIL=<email>
# Admin console sign-in through Firebase (D-167). Also add the web domain under Firebase → Authentication →
# Settings → Authorized domains.
# FIREBASE_PROJECT_ID=<firebase project id>
# FIREBASE_WEB_API_KEY=<Firebase → Project settings → Your apps → Web app → apiKey>
