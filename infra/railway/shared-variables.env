# Railway → your project → Settings → Shared Variables. Paste these, then replace every <...>.
# Secrets: make each with `openssl rand -hex 32` on your Mac. Never commit real values.

# Test mode (fake SMS / payments / maps are only allowed outside "production").
NODE_ENV=development
# The 000000 shortcut is OFF on a shared server; only these numbers sign in, each with its own code.
OTP_DEV_BYPASS=false
TEST_LOGINS=<+91XXXXXXXXXX:123456,+919000000001:654321>
APP_VERSION=0.1.0
LOG_LEVEL=info
MIN_SUPPORTED_APP_VERSION=0.1.0
LATEST_APP_VERSION=0.1.0
TRUST_PROXY_HOPS=1
API_WORKERS=1

# Supabase → Connect → Session pooler (port 5432). No ?sslmode in the URL: DATABASE_CA_CERT turns on
# verified TLS. Paste the certificate from Database → Settings → SSL Configuration with each newline as \n.
DATABASE_URL=postgres://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres
DATABASE_CA_CERT=<-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE----->
DATABASE_POOL_MAX=4

# Railway Redis service. family=0 lets the client use Railway's IPv6 private network.
REDIS_URL=${{Redis.REDIS_URL}}?family=0

JWT_ACCESS_SECRET=<openssl rand -hex 32>
TOKEN_HASH_PEPPER=<openssl rand -hex 32>
SIGNED_URL_SECRET=<openssl rand -hex 32>

# Public addresses Railway gives each service (Settings → Networking → Generate Domain).
API_PUBLIC_URL=https://<api-domain>.up.railway.app
WEB_PUBLIC_URL=https://<web-domain>.up.railway.app
CORS_ORIGINS=https://<web-domain>.up.railway.app

SMS_PROVIDER=fake
PAYMENTS_PROVIDER=fake
PAYMENTS_FAKE_AUTO_SETTLE=true
PUSH_PROVIDER=fake
MAPS_PROVIDER=fake
WEATHER_PROVIDER=fake
MODERATION_PROVIDER=fake
ANALYTICS_PROVIDER=noop
EMAIL_PROVIDER=fake

# Photos: the RustFS service (S3-compatible, same as local development).
STORAGE_PROVIDER=s3
S3_ENDPOINT=https://<storage-domain>.up.railway.app
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=<same as RUSTFS_ACCESS_KEY on the storage service>
S3_SECRET_ACCESS_KEY=<same as RUSTFS_SECRET_KEY on the storage service>
S3_FORCE_PATH_STYLE=true
S3_BUCKET_MEDIA=touchgrass-media
MEDIA_PUBLIC_BASE_URL=https://<storage-domain>.up.railway.app/touchgrass-media
