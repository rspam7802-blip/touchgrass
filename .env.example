# TouchGrass environment. Copy to .env for local development: `cp .env.example .env` (pnpm dev does this for you).
# Local defaults use FAKE adapters, so the whole stack runs end to end with no API keys.
# In production every secret is injected from AWS Secrets Manager by ECS; never commit real values.

# ---------- Core ----------
NODE_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=info
API_PORT=4000
# API processes per container (node:cluster); match the task's vCPUs in production.
API_WORKERS=1
REALTIME_PORT=4001
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
# Universal / App Links for share URLs (served by apps/web at /.well-known/*).
# APPLE_TEAM_ID=                       # developer.apple.com → Membership → Team ID
# IOS_BUNDLE_ID=app.touchgrass
# ANDROID_PACKAGE=app.touchgrass
# ANDROID_SHA256_CERT_FINGERPRINTS=    # Play Console → App integrity → App signing key SHA-256 (comma-separated)
# Support address on the web /delete-account page (shown only when set).
# SUPPORT_EMAIL=support@touchgrass.co.in
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Number of trusted proxy hops in front of the API (1 behind the ALB in AWS).
TRUST_PROXY_HOPS=0

# ---------- Data stores (docker-compose in infra/docker) ----------
DATABASE_URL=postgres://touchgrass:touchgrass@localhost:5432/touchgrass
# Optional read replica for feeds/search. Omit locally; set to the RDS reader endpoint in AWS.
# DATABASE_REPLICA_URL=
DATABASE_POOL_MAX=20
REDIS_URL=redis://localhost:6379

# ---------- Secrets we generate ourselves ----------
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789abcdef
TOKEN_HASH_PEPPER=dev-only-token-pepper-change-me-0123456789abcdef
SIGNED_URL_SECRET=dev-only-signed-url-secret-change-me-0123456789ab

# ---------- Mobile app version gate (F-PLT-02) ----------
MIN_SUPPORTED_APP_VERSION=0.1.0
LATEST_APP_VERSION=0.1.0

# ---------- SMS / OTP: MSG91 (https://control.msg91.com → API keys; templates must be DLT-registered) ----------
SMS_PROVIDER=fake
# Lean launch (D-166): SMS_PROVIDER=none + PHONE_AUTH_PROVIDER=firebase — Firebase texts sign-in codes, the
# server sends no SMS, and the app texts SOS contacts from the person's own phone.
# PHONE_AUTH_PROVIDER=firebase
# FIREBASE_PROJECT_ID=        # Firebase console → Project settings → Project ID
# Website admin sign-in through Firebase too (D-167; web service): the Web app's public API key.
# FIREBASE_WEB_API_KEY=       # Firebase console → Project settings → Your apps → Web app → apiKey
# MSG91_AUTH_KEY=            # MSG91 dashboard → Authkey
# MSG91_OTP_TEMPLATE_ID=     # MSG91 → OTP → Templates (DLT approved)
# App Store / Play review sign-in: this number gets this fixed 6-digit code, no SMS (works in production).
# STORE_REVIEW_PHONE=+91XXXXXXXXXX
# STORE_REVIEW_OTP=
# MSG91_SMS_FLOW_ID=         # MSG91 → SMS → Flows (live-location / SOS / invite link template)

# ---------- Payments: Razorpay (https://dashboard.razorpay.com → Settings → API Keys / Webhooks; Route enabled) ----------
PAYMENTS_PROVIDER=fake
# Free plans only (D-165): PAYMENTS_PROVIDER=disabled — no ticket sales, allowed in production.
# RAZORPAY_KEY_ID=           # Settings → API Keys (rzp_live_… / rzp_test_…)
# RAZORPAY_KEY_SECRET=       # shown once when the key is generated
# RAZORPAY_WEBHOOK_SECRET=   # Settings → Webhooks → secret you choose for {API_PUBLIC_URL}/v1/webhooks/razorpay

# ---------- Push: Expo (https://expo.dev → Account settings → Access tokens; enable "Enhanced security for push") ----------
PUSH_PROVIDER=fake
# EXPO_ACCESS_TOKEN=

# ---------- Media storage: S3 + CloudFront (local: RustFS S3-compatible store from docker-compose) ----------
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
# Testing on a phone over Wi-Fi: the laptop's address for the store, so photo links and uploads work on the phone
# (the server keeps using S3_ENDPOINT). Find it with `ipconfig` (Windows) or `ipconfig getifaddr en0` (Mac).
# S3_PUBLIC_ENDPOINT=http://192.168.1.20:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=touchgrass
S3_SECRET_ACCESS_KEY=touchgrass-secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET_MEDIA=touchgrass-media
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/touchgrass-media
# In AWS: omit S3_ENDPOINT and the access keys (the ECS task role grants access), set S3_FORCE_PATH_STYLE=false
# and MEDIA_PUBLIC_BASE_URL to the CloudFront distribution URL.

# ---------- Maps: Google Maps Platform (https://console.cloud.google.com → APIs: Places API (New), Geocoding API) ----------
MAPS_PROVIDER=fake
# GOOGLE_MAPS_API_KEY=       # server key, restricted by IP + API
# The mobile app needs separate, app-restricted keys: EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY / _IOS_KEY (see apps/mobile/.env.example)

# ---------- Weather: OpenWeather One Call 3.0 (https://home.openweathermap.org/api_keys; subscribe to One Call 3.0) ----------
WEATHER_PROVIDER=fake
# Keyless (D-165): WEATHER_PROVIDER=open-meteo (free tier is non-commercial; OPEN_METEO_API_KEY for the paid API) or none.
# OPENWEATHER_API_KEY=

# ---------- Image moderation + face compare: AWS Rekognition (IAM task role; region ap-south-1) ----------
MODERATION_PROVIDER=fake
# Google instead of AWS (D-165): MODERATION_PROVIDER=google-vision + GOOGLE_VISION_API_KEY (restrict it to the Vision API).
AWS_REGION=ap-south-1

# ---------- Analytics: PostHog (https://eu.posthog.com → Project settings → Project API key) ----------
ANALYTICS_PROVIDER=noop
# POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# ---------- Email: AWS SES in production, Mailpit locally (http://localhost:8025) ----------
EMAIL_PROVIDER=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=TouchGrass <hello@touchgrass.co.in>

# ---------- Observability ----------
# SENTRY_DSN=                # https://sentry.io → Project → Client Keys (DSN)
# OTEL_EXPORTER_OTLP_ENDPOINT= # e.g. the ADOT collector sidecar, http://localhost:4318
