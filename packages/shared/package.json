    "zod": "4.6.7"
  },
  "devDependencies": {
    "@touchgrass/config": "workspace:*",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
